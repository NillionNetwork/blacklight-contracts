# Copy this file to a local untracked file (example: .env.local, .env.testnet.local)
# Then pass it with: ./script/deployment/deploy.sh <target> --profile <file>

# -----------------------------------------------------------------------------
# Shared
# -----------------------------------------------------------------------------
PRIVATE_KEY=0x
RPC_URL=http://127.0.0.1:8545
EXPECTED_CHAIN_ID=31337

# Optional deployment parameters consumed by Solidity scripts
# USE_NOOP_SLASHING=true
# BASE_COMMITTEE_SIZE=25
# MAX_COMMITTEE_SIZE=100
# MAX_ESCALATIONS=0
# QUORUM_BPS=6700
# VERIFICATION_BPS=6700
# RESPONSE_WINDOW_SEC=300
# JAIL_DURATION_SEC=120
# UNSTAKE_DELAY_SEC=604800
# MIN_OPERATOR_STAKE=70000000000
# MIN_COMMITTEE_VP=140000000000
# REWARD_EPOCH_DURATION=604800
# REWARD_MAX_PAYOUT_PER_FINALIZE=0

# -----------------------------------------------------------------------------
# Node managers / local operators
# -----------------------------------------------------------------------------
MNEMONIC="test test test test test test test test test test test junk"
NUM_OPERATORS=10
NUM_MANAGED_NODES=0
DEPLOY_NODE_FACTORY=true

